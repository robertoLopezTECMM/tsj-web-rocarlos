{
  "name": "web-tsj-2025",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",


  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "electron-builder"
  },
    "build": {
    "appId": "com.tsj.web",
    "productName": "TSJ Web",
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@emnapi/**/*",
      "node_modules/@tailwindcss/oxide-wasm32-wasi/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@emnapi/core": "^1.0.0",
    "@fullpage/react-fullpage": "^0.1.48",
    "@headlessui/react": "^2.2.4",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.1.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-oauth/google": "^0.12.2",
    "@tailwindcss/vite": "^4.1.12",
    "axios": "^1.10.0",
    "crypto-js": "^4.2.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "fullpage.js": "^4.0.36",
    "keen-slider": "^6.8.6",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.1",
    "motion": "^12.23.24",
    "open": "^10.2.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-modern-drawer": "^1.4.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5",
    "wait-on": "^9.0.1"
  }
}
